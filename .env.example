# Alliance DevOps Dashboard — Environment Configuration
# Copy this file to .env and fill in values for local development.

# Application
NODE_ENV=development
LOG_LEVEL=info
AWS_REGION=us-east-1

# DynamoDB
EVENTS_TABLE_NAME=devops-dashboard-dev-events
RELEASES_TABLE_NAME=devops-dashboard-dev-releases
IMPROVEMENTS_TABLE_NAME=devops-dashboard-dev-improvements
PLATFORMS_TABLE_NAME=devops-dashboard-dev-platforms

# Updown Alert Ingestion (updown-alert-ingestion)
APP_NAME=alliance-devops-dashboard
LAMBDA_NAME=updown-alert-ingestion
ENVIRONMENT=dev
UPTIME_EVENTS_TABLE=local
UPDOWN_CHECKS_TABLE=local
UPDOWN_WEBHOOK_SECRET=replace_me

# Other integrations (future)
JENKINS_BASE_URL=https://jenkins.example.com
JENKINS_API_TOKEN=placeholder
UPDOWN_API_KEY=placeholder
RELEASE_NOTES_API_URL=https://api.example.com/release-notes

# Observability
ENABLE_XRAY=false
SERVICE_NAME=alliance-devops-dashboard
