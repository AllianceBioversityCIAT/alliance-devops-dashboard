{
  "name": "alliance-devops-dashboard",
  "version": "0.1.0",
  "description": "Centralized platform for DevOps operational metrics, delivery insights, and reliability indicators across Alliance digital products",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/prepare-lambda-dist.mjs",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "sam:build": "sam build --template-file infrastructure/sam/template.yaml",
    "sam:local": "sam local start-api --template-file infrastructure/sam/template.yaml",
    "local:updown": "tsx --env-file=.env scripts/local-webhook-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.821.0",
    "@aws-sdk/lib-dynamodb": "^3.821.0",
    "@aws-sdk/client-secrets-manager": "^3.821.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.29",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "@vitest/coverage-v8": "^3.2.1",
    "eslint": "^9.28.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "license": "Apache-2.0"
}
